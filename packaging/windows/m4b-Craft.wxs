<?xml version='1.0' encoding='utf-8'?>
<!-- Base layout; release packager generates a component for every payload file. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="5d4769be-a691-5d64-85d6-842b5d2519e4" Name="m4b-Craft" Language="1033" Version="0.3.0" Manufacturer="m4b-Craft contributors" UpgradeCode="790fce8b-e564-43b1-9701-d427fdd80c6c">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Description="m4b-Craft audiobook editor" />
    <Media Id="1" Cabinet="application.cab" EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer m4b-Craft is already installed." />
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize" />
    </InstallExecuteSequence>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="Programs" Name="Programs">
          <Directory Id="INSTALLDIR" Name="m4b-Craft">
            <Component Id="C0" Guid="6ef1b0d0-c403-5fcf-ba73-6d69b61c174e" Win64="yes">
              <File Id="F0" Source="$(var.PayloadDir)/m4b-Craft.exe" Name="m4b-Craft.exe" KeyPath="yes">
                <Shortcut Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Name="m4b-Craft" WorkingDirectory="INSTALLDIR" Advertise="yes" />
              </File>
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="m4b-Craft">
          <Component Id="UserRegistration" Guid="20b7c410-3d0f-56d2-ae5f-8bff97c20453" Win64="yes">
            <RegistryValue Root="HKCU" Key="Software\m4b-Craft" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
            <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Complete" Title="m4b-Craft" Level="1">
      <ComponentRef Id="UserRegistration" />
      <ComponentRef Id="C0" />
    </Feature>
  </Product>
</Wix>